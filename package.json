{
  "name": "cardumy",
  "version": "0.1.0",
  "private": true,
  "description": "API do Cardumy: flashcards com revisão espaçada e geração de cards por IA",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "tsx watch src/main-api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main-api.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}

# Copy to .env (ignored by git) and adjust. Locally every variable is optional.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres from compose.yaml. Optional locally (this is the default),
# REQUIRED in production.
DATABASE_URL=postgres://cardumy:cardumy@localhost:5433/cardumy

# Signs the login tokens (at least 32 characters). Optional locally,
# REQUIRED in production. Generate one with: openssl rand -base64 48
# JWT_SECRET=

# Object storage (S3 API). Optional locally: the defaults point to RustFS
# from compose.yaml (web console at http://localhost:9001).
# REQUIRED in production, where they point to Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=cardumy
# S3_ACCESS_KEY_ID=cardumy
# S3_SECRET_ACCESS_KEY=cardumy-local-secret

# Redis from compose.yaml (used from stage 6 on).
# REDIS_URL=redis://localhost:6379

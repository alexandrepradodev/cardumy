# Copy to .env (ignored by git) and adjust. Locally every variable is optional.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres from compose.yaml. Optional locally (this is the default),
# REQUIRED in production.
DATABASE_URL=postgres://cardumy:cardumy@localhost:5433/cardumy

# Signs the login tokens (at least 32 characters). Optional locally,
# REQUIRED in production. Generate one with: openssl rand -base64 48
# JWT_SECRET=

# Redis from compose.yaml (used from stage 6 on).
# REDIS_URL=redis://localhost:6379
